# ==============================================================================
# InsightLens Backend Environment Configuration (.env.example)
# ==============================================================================

# --- [REQUIRED IN PRODUCTION] ---
# PostgreSQL database connection string (e.g., Aiven, Neon, Supabase, or self-hosted)
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# Optional trusted CA certificate for production PostgreSQL TLS validation.
# Use the CA certificate provided by your database vendor; keep it out of Git.
DATABASE_CA_CERT=

# Secure JWT signing secret (Must be at least 16 characters in production)
JWT_SECRET=your_secure_random_jwt_secret_min_16_chars

# Primary AI Provider: Google Gemini API Key for multimodal visual synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins (Comma-separated list or single URL)
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Default: 3000)
PORT=3000

# --- [OPTIONAL / FAILOVER] ---
# OpenRouter API Key for multi-provider AI gateway failover
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key for ultra-fast LPU vision and text inference
GROQ_API_KEY=

# Providers are attempted sequentially in this fixed order: Gemini, Groq, OpenRouter.
AI_PROVIDERS=gemini,openrouter,groq

# --- [RATE LIMIT TUNING (OPTIONAL)] ---
# Max authentication attempts per 15-minute window (Default: 20)
AUTH_RATE_LIMIT_MAX=20

# Max visual analysis requests per 10-minute window per user/IP (Default: 20)
ANALYZE_RATE_LIMIT_MAX=20

# Max general API requests per 15-minute window (Default: 150)
API_RATE_LIMIT_MAX=150
